# Lightweight Agent Framework — Environment Variables
# Copy to .env: cp .env.template .env

# ── LLM Provider ──────────────────────────────────
# Options: openai | deepseek | qwen
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ── Individual Provider Keys ──────────────────────
OPENAI_API_KEY=sk-your-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1

DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

QWEN_API_KEY=sk-your-qwen-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── Agent Parameters ──────────────────────────────
AGENT_MAX_ITERATIONS=10
AGENT_TEMPERATURE=0.3

# ── Memory ────────────────────────────────────────
# Options: sliding_window | vector | none
MEMORY_TYPE=sliding_window
MEMORY_WINDOW_SIZE=6

# ── Dispatcher ────────────────────────────────────
DISPATCHER_MAX_RETRIES=2

# ── Logging ───────────────────────────────────────
LOG_LEVEL=INFO
